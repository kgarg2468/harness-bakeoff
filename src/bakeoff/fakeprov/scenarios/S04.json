{
  "id": "S04",
  "title": "Two turns, then revert turn 1; the next request only appends",
  "system": "You are Rocket Agent. You build and fix RocketRide pipelines (.pipe JSON files) in the working copy with the tools provided. Validate every pipeline you write before you answer.",
  "model": {"kind": "openrouter", "model": "anthropic/claude-sonnet-4.5"},
  "rules": {"*": "allow"},
  "limits": {"max_steps": 12},
  "engine": {"delay_ms": 0},
  "driver": [
    {"user": "Create notes.md with a title."},
    {"user": "Now create todo.md with one item."},
    {"revert": 1},
    {"user": "Which files are in the working copy now?"}
  ],
  "exchanges": [
    {
      "expect": {"last_role": "user", "messages_len": 2},
      "respond": {
        "stream": [
          {
            "tool_calls": [
              {
                "id": "call_S04_1",
                "name": "write_file",
                "arguments": {"path": "notes.md", "content": "# Notes\n"}
              }
            ]
          },
          {"finish": "tool_calls"},
          {"usage": {"prompt_tokens": 900, "completion_tokens": 40, "cost": 0.0033}}
        ]
      }
    },
    {
      "expect": {"last_role": "tool", "messages_len": 4, "tool_result_contains": {"call_S04_1": ""}},
      "respond": {
        "stream": [
          {"text": "Created notes.md.", "chunks": 3},
          {"finish": "stop"},
          {"usage": {"prompt_tokens": 1000, "completion_tokens": 20, "cost": 0.0033}}
        ]
      }
    },
    {
      "expect": {"last_role": "user", "messages_len": 6, "last_content_contains": "todo.md"},
      "respond": {
        "stream": [
          {
            "tool_calls": [
              {
                "id": "call_S04_2",
                "name": "write_file",
                "arguments": {"path": "todo.md", "content": "# TODO\n\n- validate agent.pipe\n"}
              }
            ]
          },
          {"finish": "tool_calls"},
          {"usage": {"prompt_tokens": 900, "completion_tokens": 40, "cost": 0.0033}}
        ]
      }
    },
    {
      "expect": {"last_role": "tool", "messages_len": 8, "tool_result_contains": {"call_S04_2": ""}},
      "respond": {
        "stream": [
          {"text": "Created todo.md.", "chunks": 3},
          {"finish": "stop"},
          {"usage": {"prompt_tokens": 1000, "completion_tokens": 20, "cost": 0.0033}}
        ]
      }
    },
    {
      "note": "After the revert: history is turns 1-2, the revert note, then this user message.",
      "expect": {"last_role": "user", "last_content_contains": "Which files"},
      "respond": {
        "stream": [
          {
            "tool_calls": [{"id": "call_S04_3", "name": "list_files", "arguments": {"path": "."}}]
          },
          {"finish": "tool_calls"},
          {"usage": {"prompt_tokens": 900, "completion_tokens": 40, "cost": 0.0033}}
        ]
      }
    },
    {
      "expect": {"last_role": "tool", "tool_result_contains": {"call_S04_3": "todo.md"}},
      "respond": {
        "stream": [
          {"text": "Only todo.md is left; notes.md was removed by the revert.", "chunks": 3},
          {"finish": "stop"},
          {"usage": {"prompt_tokens": 1000, "completion_tokens": 20, "cost": 0.0033}}
        ]
      }
    }
  ],
  "expect": {
    "stops": ["end_turn", "end_turn", "end_turn"],
    "requests": 6,
    "commits": 4,
    "files": {"notes.md": null, "todo.md": "# TODO"},
    "tool_runs": {"call_S04_1": 1, "call_S04_2": 1, "call_S04_3": 1}
  }
}
