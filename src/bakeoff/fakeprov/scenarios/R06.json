{
  "id": "R06",
  "title": "Responses API: a user message with images becomes input_text and input_image parts, in every request",
  "system": "You are Rocket Agent. You build and fix RocketRide pipelines (.pipe JSON files) in the working copy with the tools provided. Validate every pipeline you write before you answer.",
  "model": {
    "kind": "openai_responses",
    "model": "gpt-6-luna",
    "reasoning": {"effort": "xhigh"},
    "temperature": null
  },
  "rules": {"*": "allow"},
  "limits": {"max_steps": 12},
  "engine": {"delay_ms": 0},
  "strict": {
    "reject_params": ["temperature", "max_tokens", "max_completion_tokens", "reasoning_effort"],
    "reject_unencrypted_reasoning": true
  },
  "driver": [
    {
      "user": [
        {"type": "text", "text": "Which component in this sketch reads the chat? Look it up."},
        {
          "type": "image_url",
          "image_url": {"url": "https://example.com/sketches/chat-pipeline.png"}
        },
        {
          "type": "image_url",
          "image_url": {
            "url": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNkYPhfDwAChwGA60e6kgAAAABJRU5ErkJggg==",
            "detail": "low"
          }
        }
      ]
    }
  ],
  "exchanges": [
    {
      "note": "The chat parts as input parts: the image URL flat, detail auto unless the part says.",
      "expect": {
        "input_len": 1,
        "last_role": "user",
        "input_at": [
          {
            "index": 0,
            "role": "user",
            "contains": "this sketch",
            "parts": [
              {
                "type": "input_text",
                "text": "Which component in this sketch reads the chat? Look it up."
              },
              {
                "type": "input_image",
                "image_url": "https://example.com/sketches/chat-pipeline.png",
                "detail": "auto"
              },
              {
                "type": "input_image",
                "image_url": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNkYPhfDwAChwGA60e6kgAAAABJRU5ErkJggg==",
                "detail": "low"
              }
            ]
          }
        ]
      },
      "respond": {
        "stream": [
          {
            "tool_calls": [
              {"id": "call_R06_1", "name": "describe_component", "arguments": {"name": "chat"}}
            ]
          },
          {"completed": {"input_tokens": 1900, "output_tokens": 40}}
        ]
      }
    },
    {
      "note": "The next request replays the user message with the same parts.",
      "expect": {
        "input_len": 3,
        "last_type": "function_call_output",
        "tool_result_contains": {"call_R06_1": "questions"},
        "input_at": [
          {
            "index": 0,
            "role": "user",
            "parts": [
              {
                "type": "input_text",
                "text": "Which component in this sketch reads the chat? Look it up."
              },
              {
                "type": "input_image",
                "image_url": "https://example.com/sketches/chat-pipeline.png",
                "detail": "auto"
              },
              {
                "type": "input_image",
                "image_url": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNkYPhfDwAChwGA60e6kgAAAABJRU5ErkJggg==",
                "detail": "low"
              }
            ]
          }
        ]
      },
      "respond": {
        "stream": [
          {
            "text": "The chat component reads the chat and sends its questions on.",
            "phase": "final_answer"
          },
          {"completed": {"input_tokens": 2000, "output_tokens": 20}}
        ]
      }
    }
  ],
  "expect": {
    "stops": ["end_turn"],
    "requests": 2,
    "commits": 1,
    "text_contains": "chat component",
    "tool_runs": {"call_R06_1": 1}
  }
}
